{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@causcape/common": ["./common/src/index.ts"],
      "@causcape/common/*": ["./common/src/*"],
      "@causcape/element": ["./element/src/index.ts"],
      "@causcape/element/*": ["./element/src/*"],
      "@causcape/causcape": ["./causcape/index.tsx"],
      "@causcape/causcape/*": ["./causcape/*"],
      "@causcape/laser-pointer": ["./laser-pointer/src/index.ts"],
      "@causcape/laser-pointer/*": ["./laser-pointer/src/*"],
      "@causcape/math": ["./math/src/index.ts"],
      "@causcape/math/*": ["./math/src/*"],
      "@causcape/utils": ["./utils/src/index.ts"],
      "@causcape/utils/*": ["./utils/src/*"],
      "@causcape/fractional-indexing": ["./fractional-indexing/src/index.ts"],
      "@causcape/fractional-indexing/*": ["./fractional-indexing/src/*"]
    }
  }
}
