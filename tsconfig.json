{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@causcape/core": ["./packages/causcape-core/src/index.ts"],
      "@causcape/core/*": ["./packages/causcape-core/src/*"],
      "@causcape/common": ["./packages/common/src/index.ts"],
      "@causcape/common/*": ["./packages/common/src/*"],
      "@causcape/causcape": ["./packages/causcape/index.tsx"],
      "@causcape/causcape/*": ["./packages/causcape/*"],
      "@causcape/element": ["./packages/element/src/index.ts"],
      "@causcape/element/*": ["./packages/element/src/*"],
      "@causcape/fractional-indexing": ["./packages/fractional-indexing/src/index.ts"],
      "@causcape/fractional-indexing/*": ["./packages/fractional-indexing/src/*"],
      "@causcape/laser-pointer": ["./packages/laser-pointer/src/index.ts"],
      "@causcape/laser-pointer/*": ["./packages/laser-pointer/src/*"],
      "@causcape/math": ["./packages/math/src/index.ts"],
      "@causcape/math/*": ["./packages/math/src/*"],
      "@causcape/utils": ["./packages/utils/src/index.ts"],
      "@causcape/utils/*": ["./packages/utils/src/*"],
      "@causcape/graph": ["./packages/graph/src/index.ts"],
      "@causcape/graph/*": ["./packages/graph/src/*"]
    }
  },
  "include": ["packages", "causcape-app"],
  "exclude": ["examples", "**/build", "**/dist", "**/types", "**/tests", "**/__tests__", "**/*.test.*"]
}
